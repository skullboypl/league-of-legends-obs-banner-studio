# CapRover: App Configs → Environment Variables
# Klucz jest odczytywany w runtime przez backend, nie podczas budowania frontendu.
RIOT_API_KEY=RGAPI-your-production-key
RIOT_VERIFY=riot-verification-code
PORT=8787
SITE_URL=https://twoja-domena.pl
# Ustaw 1 po akceptacji aplikacji przez Riot, aby ukryć komunikat o wersji demonstracyjnej.
RIOT_APPROVED=0
